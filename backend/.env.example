DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000

# Gmail SMTP example. Use a Google App Password, never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=Barangay Poblacion <your-sending-account@gmail.com>

# URL where the admin frontend is available to applicants.
FRONTEND_URL=http://localhost:5173
